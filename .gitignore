# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Data - raw is user-provided and read-only, processed is derived; neither
# is committed by default. Un-ignore specific files deliberately if wanted.
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# Personal usage log from the Streamlit app (logs/meal_log.csv) — real
# day-to-day data generated by using the app, not committed by default.
logs/*
!logs/README.md

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
